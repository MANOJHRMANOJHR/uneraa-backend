{
  "entryFile": "server.ts",
  "authenticationModule": "./src/middleware/auth.middleware.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/controllers/*.ts"],
  "spec": {
    "outputDirectory": "src/docs",
    "specVersion": 3,
    "basePath": "/api/v1",
    "name": "UNERRA API",
    "version": "1.0.0",
    "description": "API Docs for UNERRA"
  },
  "routes": {
    "authenticationModule": "./src/middleware/auth.middleware.ts",
    "routesDir": "./src/build",
    "basePath": "/api/v1",
    "routesFileName": "routes.ts"
  },
  "securityDefinitions": {
    "jwt": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
